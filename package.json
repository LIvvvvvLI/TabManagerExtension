{
  "name": "tab-manager",
  "displayName": "Tab Manager - 标签页管理器",
  "description": "集中查看、搜索、切换和批量关闭 VS Code 标签页，并显示标签类型与路径信息",
  "version": "2.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "tab",
    "manager",
    "close",
    "editor",
    "tabs",
    "IDEA",
    "productivity",
    "batch",
    "multi-select"
  ],
  "main": "./out/extension.js",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#4A90D9",
    "theme": "light"
  },
  "contributes": {
    "commands": [
      {
        "command": "tabManager.showTabs",
        "title": "显示所有标签页",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tabManager.showTabs",
          "group": "navigation@100",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tabManager.showTabs",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "configuration": {
      "title": "Tab Manager",
      "properties": {
        "tabManager.showRelativePath": {
          "type": "boolean",
          "default": true,
          "description": "是否在标签页列表中显示相对路径（显示在文件名右侧）"
        },
        "tabManager.showAbsolutePath": {
          "type": "boolean",
          "default": false,
          "description": "是否在标签页列表中显示绝对路径（显示在文件名下方）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.3.2",
    "@vscode/vsce": "^2.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vscode-tab-manager.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/vscode-tab-manager/issues"
  },
  "homepage": "https://github.com/your-username/vscode-tab-manager#readme",
  "license": "MIT"
}
